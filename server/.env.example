# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Resend API key for sending login codes (https://resend.com/api-keys).
# If left blank, the server logs login codes to the console instead of emailing
# them — handy for local development without a key.
RESEND_API_KEY=

# The "From" address for login emails.
# Testing (no setup): onboarding@resend.dev
# Production: a verified-domain address, e.g. login@yourdomain.com
FOODIT_FROM_EMAIL=foodit <onboarding@resend.dev>

# Public URL of the app (used in login emails). Defaults to the dev client.
FOODIT_APP_URL=http://localhost:3000
