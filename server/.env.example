# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Postgres connection string (Vercel Postgres / Neon). In production Vercel
# injects this automatically; locally, pull it with `vercel env pull server/.env`
# after the Vercel project + Postgres exist, or paste one from the Neon dashboard.
# `bun run dev` and `bun run migrate` both read it from here. See ADR-008.
POSTGRES_URL=

# Resend API key for sending login codes and household invites
# (https://resend.com/api-keys). If left blank, the server logs both to the
# console instead of emailing them — handy for local development without a key.
RESEND_API_KEY=

# The "From" address for login and invite emails.
# Testing (no setup): onboarding@resend.dev — note Resend only delivers to your
# own address until you verify a domain, so invites to household members will
# fail (the invite is still created; the admin sees a warning).
# Production: a verified-domain address, e.g. login@yourdomain.com
FOODIT_FROM_EMAIL=foodit <onboarding@resend.dev>

# Public URL of the app. Invite emails link here so the invitee can sign in.
# Defaults to the dev client.
FOODIT_APP_URL=http://localhost:3000
